PORT=3000
NODE_ENV=development
LOG_LEVEL=info


# ==============================
# Ollama
# ==============================

OLLAMA_BASE_URL=http://localhost:11434

# ==============================
# Ollama LLM Models
# ==============================

OLLAMA_LLM_LLAMA3_2=llama3.2:latest
OLLAMA_LLM_PHI3_MINI=phi3:mini
OLLAMA_LLM_QWEN3_1_7B=qwen3:1.7b
OLLAMA_LLM_DEEPSEEK_R1_7B=deepseek-r1:7b

# ==============================
# Ollama Embedding Models
# ==============================

OLLAMA_EMBEDDING_BGE_M3=bge-m3:latest
OLLAMA_EMBEDDING_QWEN3_0_6B=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_NOMIC_EMBED_TEXT=nomic-embed-text:latest
